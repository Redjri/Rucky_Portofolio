---
// src/pages/index.astro
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>Portfolio Kece & Optimal</title>
    <meta name="viewport" content="width=device-width" />
  </head>
  <body class="bg-slate-950 text-white">
    
    <!-- Bagian Hero Portfolio -->
    <main class="h-screen flex flex-col justify-center items-center">
      <h1 class="hero-title text-5xl font-bold opacity-0">Halo, Saya Web Developer</h1>
      <p class="hero-desc text-lg mt-4 opacity-0 text-gray-400">Fokus pada Performa & Animasi Halus</p>
    </main>

    <!-- Zona Klien (GSAP Animation) -->
    <script>
    import { gsap } from "gsap";
    window.addEventListener("DOMContentLoaded", () => {
      const tl = gsap.timeline();
      // fromTo mengatur dari posisi AWAL (from) menuju posisi AKHIR (to)
      tl.fromTo(".hero-title", 
        { opacity: 0, y: 50 }, // Mulai dari transparan & turun 50px ke bawah
        { opacity: 1, y: 0, duration: 1, ease: "power3.out" } // Bergerak ke posisi normal
      )
      .fromTo(".hero-desc", 
        { opacity: 0, y: 30 }, // Deskripsi mulai dari bawah 30px
        { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" }, 
        "-=0.6" // Curi start 0.6 detik
      );
    });
    </script>
  </body>
</html>

<!-- Gunakan tag style ini HANYA untuk CSS kustom yang tidak bisa di-handle Tailwind -->
<style>
  /* Contoh: font kustom atau efek spesifik */
  body {
    font-family: Inter, Roboto, 'Helvetica Neue', sans-serif;
  }

  .color1
  {
    color: #FFCA95; /* Contoh warna kustom */
  }
  .color2
  {
    color: #FF7873; /* Contoh warna kustom */
  }

  .color3
  {
    color: #E22F80; /* Contoh warna kustom */
  }

  .color4
  {
    color: #8140DC; /* Contoh warna kustom */
  }

</style>