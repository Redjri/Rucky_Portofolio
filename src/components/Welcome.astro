---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <title>Portfolio Kece & Optimal</title>
    <meta name="viewport" content="width=device-width" />
  </head>
  <body class="bg-slate-950 text-white overflow-x-hidden">

<!-- === SIDEBAR KIRI (Arknights Style) === -->
    <!-- w-20 bikin ukurannya sempit (80px), z-50 memastikannya selalu di paling atas -->
    <nav class="fixed top-0 left-0 w-20 h-full bg-black/80 backdrop-blur-sm border-r border-slate-800 flex flex-col items-center py-6 z-50">
      
      <!-- Logo Atas (Menggantikan logo Endfield) -->
      <div class="w-10 h-10 bg-white text-black font-extrabold flex items-center justify-center mb-12 cursor-pointer">
        P.
      </div>
      
      <!-- Menu Ikon Vertikal -->
      <ul class="flex flex-col gap-6 w-full items-center">
        <!-- Kotak-kotak ini anggap saja tempat untuk ikon SVG (Home, About, dll) -->
        <li class="w-full flex justify-center py-3 hover:bg-white/10 cursor-pointer transition-colors border-l-4 border-transparent hover:border-white">
          <div class="w-6 h-6 bg-slate-400 rounded-sm"></div> 
        </li>
        <li class="w-full flex justify-center py-3 hover:bg-white/10 cursor-pointer transition-colors border-l-4 border-transparent hover:border-white">
          <div class="w-6 h-6 bg-slate-400 rounded-full"></div>
        </li>
        <li class="w-full flex justify-center py-3 hover:bg-white/10 cursor-pointer transition-colors border-l-4 border-transparent hover:border-white">
          <div class="w-6 h-6 bg-slate-400 rotate-45"></div>
        </li>
      </ul>
    </nav>

    <!-- Loading Screen -->
    <div class="loading-wrapper">
      <div class="panel color1"></div>
      <div class="panel color2"></div>
      <div class="panel color3"></div>
      <div class="panel color4"></div>
    </div>


    
    <!-- Bagian Hero Portfolio -->
    <div class="content ml-64">
      <main class="ml-20 relative w-full h-screen flex flex-col justify-center p-16 bg-slate-900 bg-cover bg-center">
<div class="absolute inset-0 bg-black/40 z-0"></div>
        

      
        <h1 class="hero-title text-5xl font-bold opacity-0">Halo, Saya Web Developer</h1>
        <p class="hero-desc text-lg mt-4 opacity-0 text-gray-400">Fokus pada Performa & Animasi Halus</p>
      </main>
      
      <!-- Area Scrollable untuk Uji Coba ScrollTrigger -->
      <div class="scrollable-area"></div>
    </div>

    <!-- Zona Klien (GSAP Animation) -->
    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      // Register plugin ScrollTrigger ke GSAP
      gsap.registerPlugin(ScrollTrigger);

      document.addEventListener("DOMContentLoaded", () => {
        // 1. Animasi Loading & Intro Hero Content
        const tl = gsap.timeline();

        tl.to(".panel", {
          xPercent: 100,
          duration: 1.2,
          stagger: 0.12,
          ease: "expo.out",
          onComplete: () => {
            const loader = document.querySelector(".loading-wrapper") as HTMLElement;
            if (loader) loader.style.display = "none";
          }
        })
        .fromTo(".hero-title", 
          { opacity: 0, y: 50 }, 
          { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
          "-=0.6"
        )
        .fromTo(".hero-desc", 
          { opacity: 0, y: 30 }, 
          { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" }, 
          "-=0.6"
        );

        // // 2. ScrollTrigger untuk Smart Header (Sembunyi saat Scroll Down, Muncul saat Scroll Up)
        // const showAnim = gsap.from(".main-tool-bar", {
        //   yPercent: -100,
        //   paused: true,
        //   duration: 0.3,
        //   ease: "power2.out"
        // }).progress(1);

        // ScrollTrigger.create({
        //   start: "top top",
        //   end: "max",
        //   onUpdate: (self) => {
        //     // Jika scroll ke atas (direction === -1), tampilkan header. Jika ke bawah, sembunyikan.
        //     self.direction === -1 ? showAnim.play() : showAnim.reverse();
        //   }
        // });
      });
    </script>

    <style>
      body {
        font-family: Inter, Roboto, 'Helvetica Neue', sans-serif;
        margin: 0;
      }

      .loading-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        pointer-events: none;
      }

      .panel {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      .color1 {
        z-index: 4;
        background-color: #FFCA95;
      }
      .color2 {
        z-index: 3;
        background-color: #FF7873;
      }
      .color3 {
        z-index: 2;
        background-color: #E22F80;
      }
      .color4 {
        z-index: 1;
        background-color: #8140DC;
      }

      .scrollable-area {
        height: 200vh;
      }

      .main-tool-bar {
        height: 80px;
        background: linear-gradient(
          144.02deg,
          var(--color-blue, #3b82f6) 4.56%,
          var(--color-pink, #3b82f6) 72.98%
        );
        color: #ffffff;
        font-weight: 600;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        width: 100%;
        left: 0;
        top: 0;
        z-index: 100; /* Menjaga header tetap berada di atas konten saat di-scroll */
      }
    </style>
  </body>
</html>